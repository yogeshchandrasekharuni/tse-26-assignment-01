      "change": "fresh record_id, same listing_id and month",
      "expected": "both valid observations count"
    },
    {
      "id": "invalid_price_zero",
      "change": "price_cents=0",
      "expected": "quarantine before filtering"
    },
    {
      "id": "invalid_price_negative",
      "change": "price_cents=-1",
      "expected": "quarantine before filtering"
    },
    {
      "id": "invalid_sqft",
      "change": "sqft=0",
      "expected": "quarantine, not divide by zero"
    },
    {
      "id": "invalid_month",
      "change": "month=2026-13",
      "expected": "quarantine"
    },
    {
      "id": "invalid_zip",
      "change": "zip=00000",
      "expected": "quarantine"
    },
    {
      "id": "missing_partition",
      "change": "manifest completeness missing/incomplete",
      "expected": "DATA_INCOMPLETE"
    },
    {
      "id": "zero_selected",
      "change": "valid slice with no matching observations",
      "expected": "twelve zero counts/null medians, valid limited result"
    },
    {
      "id": "price_endpoint",
      "change": "record price equals inclusive upper/lower",
      "expected": "included"
    },
    {
      "id": "null_bound",
      "change": "price bounds null",
      "expected": "unbounded, not price=0"
    },
    {
      "id": "naive_timestamp_future_importer",
      "change": "timestamp lacks timezone",
      "expected": "reject; do not infer local timezone"
    },
    {
      "id": "utc_boundary",
      "change": "2025-12-31T23:30:00-01:00",
      "expected": "UTC month2026-01"
    },
    {
      "id": "calendar_year",
      "change": "YoY for2026-03",
      "expected": "compare2025-03, not365days or first visible row"
    },
    {
      "id": "ppsf_additive_counterexample",
