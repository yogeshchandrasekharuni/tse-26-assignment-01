      "expected": "strict validation failure"
    },
    {
      "id": "replay_prompt_changed",
      "change": "change exact semantic prompt hash",
      "expected": "REPLAY_MISS"
    },
    {
      "id": "too_many_refinements",
      "change": "request third semantic refinement",
