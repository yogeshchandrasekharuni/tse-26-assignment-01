      "expected": "median ppsf not generally oldmedian+1000/mediansqft"
    },
    {
      "id": "ranking_tie",
      "change": "equal exact pooled ppsf in two requested ZIPs",
      "expected": "ZIP ascending tie-break; ordinal ranks"
    },
    {
      "id": "null_ranking",
      "change": "requested ZIP has zero selected rows",
