{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolReceipt v1.0; numeric result uses exact rational internal representation",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "tool": {
      "enum": [
        "price_stats",
        "supply_stats",
        "region_stats"
      ]
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonical_query_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_view_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selection_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "strategy": {
      "enum": [
        "indexed",
        "full_csv",
        "rebuilt_index"
      ]
    },
    "source_snapshot_complete": {
      "type": "boolean"
    },
    "scan_complete": {
      "type": "boolean"
    },
    "visible_months": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
      },
      "minItems": 12,
      "maxItems": 12
    },
    "unavailable_lookback_months": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
      },
      "uniqueItems": true
    },
    "partition_receipts_path": {
      "type": "string",
      "minLength": 1
    },
    "result_path": {
      "type": "string",
      "minLength": 1
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "tool",
    "tool_version",
    "run_id",
    "iteration",
    "plan_sha256",
    "canonical_query_sha256",
    "dataset_view_sha256",
    "selection_sha256",
    "strategy",
    "source_snapshot_complete",
    "scan_complete",
    "visible_months",
    "unavailable_lookback_months",
    "partition_receipts_path",
    "result_path",
    "result_sha256",
    "decision_sha256",
    "duration_ms"
  ],
  "additionalProperties": false
}
