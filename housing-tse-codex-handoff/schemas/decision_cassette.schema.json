{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionCassette v1.0; only actually captured responses may use this schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "origin": {
      "enum": [
        "live_captured"
      ]
    },
    "live_campaign_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "role": {
      "enum": [
        "orchestrator",
        "price",
        "supply",
        "region",
        "reviewer",
        "composer"
      ]
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "model_profile": {
      "type": "string",
      "minLength": 1
    },
    "model_digest": {
      "type": "string",
      "minLength": 1
    },
    "fast_agent_version": {
      "type": "string",
      "minLength": 1
    },
    "requested_seed": {
      "type": "integer",
      "minimum": 0
    },
    "effective_seed": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "semantic_prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "role_instruction_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "action_schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "upstream_tool_receipts_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_view_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tool_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semantic_prompt_text": {
      "type": "string",
      "minLength": 1
    },
    "raw_response_text": {
      "type": "string"
    },
    "raw_response_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "response_disposition": {
      "enum": [
        "valid",
        "invalid_schema",
        "invalid_policy"
      ]
    },
    "captured_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "origin",
    "live_campaign_id",
    "role",
    "iteration",
    "model_profile",
    "model_digest",
    "fast_agent_version",
    "requested_seed",
    "effective_seed",
    "semantic_prompt_sha256",
    "role_instruction_sha256",
    "action_schema_sha256",
    "upstream_tool_receipts_sha256",
    "dataset_view_sha256",
    "tool_bundle_sha256",
    "semantic_prompt_text",
    "raw_response_text",
    "raw_response_sha256",
    "response_disposition",
    "captured_at_utc"
  ],
  "additionalProperties": false
}
