{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidListingObservation v1.0",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "listing_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "zip": {
      "enum": [
        "75001",
        "75006",
        "75019",
        "75024",
        "75034",
        "75038",
        "75063",
        "75080",
        "75093",
        "75201",
        "75204",
        "75214"
      ]
    },
    "property_type": {
      "enum": [
        "single_family",
        "condo",
        "townhouse"
      ]
    },
    "bedrooms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "sqft": {
      "type": "integer",
      "minimum": 1
    },
    "price_cents": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "record_id",
    "listing_id",
    "month",
    "zip",
    "property_type",
    "bedrooms",
    "sqft",
    "price_cents"
  ],
  "additionalProperties": false
}
