{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompletedAnalysis v1.0",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "completed"
      ]
    },
    "canonical": {
      "type": "object",
      "properties": {
        "window_start": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "window_end": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "monthly": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "month": {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              "listing_count": {
                "type": "integer",
                "minimum": 0
              },
              "median_price_usd": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "median_ppsf_usd": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "price_mom_pct": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ppsf_mom_pct": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "price_yoy_pct": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ppsf_yoy_pct": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "count_mom_pct": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "month",
              "listing_count",
              "median_price_usd",
              "median_ppsf_usd",
              "price_mom_pct",
              "ppsf_mom_pct",
              "price_yoy_pct",
              "ppsf_yoy_pct",
              "count_mom_pct"
            ],
            "additionalProperties": false
          },
          "minItems": 12,
          "maxItems": 12
        },
        "summary": {
          "type": "object",
          "properties": {
            "window_price_change_pct": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{6}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "window_ppsf_change_pct": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{6}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_month_price_yoy_pct": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{6}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_month_ppsf_yoy_pct": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{6}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "total_observations": {
              "type": "integer",
              "minimum": 0
            },
            "zip_rankings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "zip": {
                    "enum": [
                      "75001",
                      "75006",
                      "75019",
                      "75024",
                      "75034",
                      "75038",
                      "75063",
                      "75080",
                      "75093",
                      "75201",
                      "75204",
                      "75214"
                    ]
                  },
                  "median_ppsf_usd": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rank": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "zip",
                  "median_ppsf_usd",
                  "rank"
                ],
                "additionalProperties": false
              },
              "maxItems": 12
            }
          },
          "required": [
            "window_price_change_pct",
            "window_ppsf_change_pct",
            "last_month_price_yoy_pct",
            "last_month_ppsf_yoy_pct",
            "total_observations",
            "zip_rankings"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "window_start",
        "window_end",
        "monthly",
        "summary"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "properties": {
        "money": {
          "enum": [
            "USD",
            "USD_THOUSANDS"
          ]
        },
        "area": {
          "enum": [
            "SQFT",
            "SQM"
          ]
        },
        "monthly": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "month": {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              "median_price": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "median_price_per_area": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "month",
              "median_price",
              "median_price_per_area"
            ],
            "additionalProperties": false
          },
          "minItems": 12,
          "maxItems": 12
        }
      },
      "required": [
        "money",
        "area",
        "monthly"
      ],
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "limited"
          ]
        },
        "codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sparse_months": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "codes",
        "sparse_months"
      ],
      "additionalProperties": false
    },
    "narrative": {
      "type": "object",
      "properties": {
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "caveat_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "fact_ids",
        "caveat_codes",
        "text"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dataset_view_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "logical_multiset_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "query_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contract_version": {
          "enum": [
            "1.0"
          ]
        },
        "mode": {
          "enum": [
            "live",
            "replay",
            "policy_simulation"
          ]
        },
        "model_profile": {
          "type": "string",
          "minLength": 1
        },
        "requested_seed": {
          "type": "integer",
          "minimum": 0
        },
        "effective_seed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "seed_support": {
          "enum": [
            "verified_model_default",
            "best_effort",
            "unsupported",
            "replay_recorded"
          ]
        },
        "prompt_bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "trace_path": {
          "type": "string",
          "minLength": 1
        },
        "live_campaign_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "dataset_id",
        "snapshot_sha256",
        "dataset_view_sha256",
        "logical_multiset_sha256",
        "query_sha256",
        "contract_version",
        "mode",
        "model_profile",
        "requested_seed",
        "effective_seed",
        "seed_support",
        "prompt_bundle_sha256",
        "trace_path",
        "live_campaign_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "status",
    "canonical",
    "presentation",
    "quality",
    "narrative",
    "metadata"
  ],
  "additionalProperties": false
}
