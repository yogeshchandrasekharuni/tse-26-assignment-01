  <diagram id="skills" name="Specialist Skills">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#0d0d0d" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="st" value="Per Specialist Skills" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#ffffff;fontSize=26;fontStyle=1" vertex="1" parent="1"><mxGeometry x="80" y="55" width="360" height="40" as="geometry"/></mxCell>
        <mxCell id="ss" value="what each component owns; kept intentionally small" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#bfbfbf;fontSize=13" vertex="1" parent="1"><mxGeometry x="82" y="95" width="420" height="24" as="geometry"/></mxCell>

        <mxCell id="c1" value="Coordinator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#9f9f9f;fontColor=#ffffff;fontSize=17;fontStyle=1;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="85" y="165" width="450" height="210" as="geometry"/></mxCell>
        <mxCell id="c1txt" value="Responsibility&lt;br&gt;Run state, routing, retries, final hand-off&lt;br&gt;&lt;br&gt;Inputs&lt;br&gt;User request + current workflow state&lt;br&gt;&lt;br&gt;Skills&lt;br&gt;choose route / fan-out / merge structured outputs&lt;br&gt;&lt;br&gt;Output&lt;br&gt;next step + updated state" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#d6d6d6;fontSize=12;spacing=3" vertex="1" parent="1"><mxGeometry x="105" y="205" width="405" height="155" as="geometry"/></mxCell>

        <mxCell id="c2" value="Criteria Interpreter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#9f9f9f;fontColor=#ffffff;fontSize=17;fontStyle=1;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="575" y="175" width="455" height="220" as="geometry"/></mxCell>
        <mxCell id="c2txt" value="Responsibility&lt;br&gt;Turn user language into executable filters&lt;br&gt;&lt;br&gt;Inputs&lt;br&gt;Criteria + reviewer refinement message&lt;br&gt;&lt;br&gt;Skills&lt;br&gt;normalize price / BHK / ZIP-area / time window&lt;br&gt;decide which specialists are needed&lt;br&gt;&lt;br&gt;Output&lt;br&gt;AnalysisPlan" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#d6d6d6;fontSize=12;spacing=3" vertex="1" parent="1"><mxGeometry x="595" y="215" width="410" height="165" as="geometry"/></mxCell>

        <mxCell id="c3" value="Price Specialist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#9f9f9f;fontColor=#ffffff;fontSize=17;fontStyle=1;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="1080" y="160" width="425" height="215" as="geometry"/></mxCell>
        <mxCell id="c3txt" value="Responsibility&lt;br&gt;Price movement for selected slice&lt;br&gt;&lt;br&gt;Skills&lt;br&gt;monthly median price&lt;br&gt;median price / sqft&lt;br&gt;month-over-month and 12-month change&lt;br&gt;&lt;br&gt;Depends on&lt;br&gt;AnalysisPlan decides exact slice and metric set" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#d6d6d6;fontSize=12;spacing=3" vertex="1" parent="1"><mxGeometry x="1100" y="200" width="380" height="160" as="geometry"/></mxCell>

        <mxCell id="c4" value="Supply Specialist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#9f9f9f;fontColor=#ffffff;fontSize=17;fontStyle=1;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="95" y="440" width="440" height="210" as="geometry"/></mxCell>
        <mxCell id="c4txt" value="Responsibility&lt;br&gt;Listing availability / volume trend&lt;br&gt;&lt;br&gt;Skills&lt;br&gt;active listing count by month&lt;br&gt;sample-size / missing-month checks&lt;br&gt;simple distribution summaries&lt;br&gt;&lt;br&gt;Output&lt;br&gt;SupplyTrend + coverage flags" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#d6d6d6;fontSize=12;spacing=3" vertex="1" parent="1"><mxGeometry x="115" y="480" width="395" height="155" as="geometry"/></mxCell>

        <mxCell id="c5" value="Region Specialist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#9f9f9f;fontColor=#ffffff;fontSize=17;fontStyle=1;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="585" y="455" width="455" height="220" as="geometry"/></mxCell>
        <mxCell id="c5txt" value="Responsibility&lt;br&gt;Compare ZIPs / areas within requested scope&lt;br&gt;&lt;br&gt;Skills&lt;br&gt;group by sub-region&lt;br&gt;rank / compare only when requested&lt;br&gt;identify sparse or uneven geographic coverage&lt;br&gt;&lt;br&gt;Output&lt;br&gt;RegionalBreakdown" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#d6d6d6;fontSize=12;spacing=3" vertex="1" parent="1"><mxGeometry x="605" y="495" width="410" height="160" as="geometry"/></mxCell>

        <mxCell id="c6" value="Trend Aggregator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#9f9f9f;fontColor=#ffffff;fontSize=17;fontStyle=1;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="1090" y="440" width="415" height="210" as="geometry"/></mxCell>
        <mxCell id="c6txt" value="Responsibility&lt;br&gt;Merge specialist outputs into one trend contract&lt;br&gt;&lt;br&gt;Implementation note&lt;br&gt;Prefer deterministic Python aggregation&lt;br&gt;&lt;br&gt;Output&lt;br&gt;12 monthly rows + summary deltas + evidence counts" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#d6d6d6;fontSize=12;spacing=3" vertex="1" parent="1"><mxGeometry x="1110" y="480" width="370" height="150" as="geometry"/></mxCell>

        <mxCell id="c7" value="Coverage Reviewer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#9f9f9f;fontColor=#ffffff;fontSize=17;fontStyle=1;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="275" y="720" width="500" height="200" as="geometry"/></mxCell>
        <mxCell id="c7txt" value="Responsibility&lt;br&gt;Decide whether the run is good enough to stop&lt;br&gt;&lt;br&gt;Signals&lt;br&gt;missing months / very small slices / contradictory specialist evidence&lt;br&gt;&lt;br&gt;Output&lt;br&gt;PASS or REFINE + reason + suggested adjustment" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#d6d6d6;fontSize=12;spacing=3" vertex="1" parent="1"><mxGeometry x="295" y="760" width="455" height="140" as="geometry"/></mxCell>

        <mxCell id="c8" value="Report Composer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#9f9f9f;fontColor=#ffffff;fontSize=17;fontStyle=1;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12" vertex="1" parent="1"><mxGeometry x="865" y="735" width="430" height="180" as="geometry"/></mxCell>
        <mxCell id="c8txt" value="Responsibility&lt;br&gt;Turn validated trend contract into user-facing summary&lt;br&gt;&lt;br&gt;Skills&lt;br&gt;plain-language trend explanation&lt;br&gt;surface caveats / coverage notes&lt;br&gt;&lt;br&gt;Does not recompute statistics" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#d6d6d6;fontSize=12;spacing=3" vertex="1" parent="1"><mxGeometry x="885" y="775" width="385" height="125" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="control" name="Control Logic">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#0d0d0d" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ct" value="Control Logic / Why the Loop Exists" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#ffffff;fontSize=26;fontStyle=1" vertex="1" parent="1"><mxGeometry x="80" y="55" width="520" height="40" as="geometry"/></mxCell>
        <mxCell id="cs" value="kept separate so the main topology does not become a spaghetti diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#bfbfbf;fontSize=13" vertex="1" parent="1"><mxGeometry x="82" y="95" width="560" height="24" as="geometry"/></mxCell>

        <mxCell id="step1" value="1. Interpret request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#b7b7b7;fontColor=#ffffff;fontSize=14" vertex="1" parent="1"><mxGeometry x="130" y="210" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="step2" value="2. Run selected specialists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#b7b7b7;fontColor=#ffffff;fontSize=14" vertex="1" parent="1"><mxGeometry x="450" y="205" width="235" height="66" as="geometry"/></mxCell>
        <mxCell id="step3" value="3. Aggregate monthly trend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#b7b7b7;fontColor=#ffffff;fontSize=14" vertex="1" parent="1"><mxGeometry x="800" y="215" width="235" height="62" as="geometry"/></mxCell>
        <mxCell id="step4" value="4. Coverage review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#b7b7b7;fontColor=#ffffff;fontSize=14" vertex="1" parent="1"><mxGeometry x="1135" y="205" width="210" height="66" as="geometry"/></mxCell>
        <mxCell id="gate" value="pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#b7b7b7;fontColor=#ffffff;fontSize=13" vertex="1" parent="1"><mxGeometry x="1180" y="360" width="125" height="84" as="geometry"/></mxCell>
        <mxCell id="done" value="compose report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#b7b7b7;fontColor=#ffffff;fontSize=14" vertex="1" parent="1"><mxGeometry x="1145" y="540" width="205" height="62" as="geometry"/></mxCell>
        <mxCell id="feedback" value="refinement message\n(scope / filters / specialist set)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#b7b7b7;fontColor=#ffffff;fontSize=13" vertex="1" parent="1"><mxGeometry x="530" y="520" width="285" height="78" as="geometry"/></mxCell>

        <mxCell id="why" value="Why this is a real dependency" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#ffffff;fontSize=18;fontStyle=1" vertex="1" parent="1"><mxGeometry x="130" y="700" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="whyTxt" value="The reviewer does not just annotate the result. A REFINE decision changes the next AnalysisPlan: the criteria can be widened/narrowed, a region can be removed, or a specialist can be added/omitted. That means one agent's output changes what another agent does next, and the loop can visibly fire at runtime." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#d7d7d7;fontSize=14;spacing=4" vertex="1" parent="1"><mxGeometry x="130" y="745" width="690" height="140" as="geometry"/></mxCell>

        <mxCell id="stop" value="Possible stop signals" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#ffffff;fontSize=18;fontStyle=1" vertex="1" parent="1"><mxGeometry x="920" y="700" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="stopTxt" value="- all 12 months represented&lt;br&gt;- sample size above threshold&lt;br&gt;- no contradictory specialist flags&lt;br&gt;- max refinement count not exceeded" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#d7d7d7;fontSize=14;spacing=4" vertex="1" parent="1"><mxGeometry x="920" y="745" width="430" height="120" as="geometry"/></mxCell>

        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#cfcfcf;endArrow=classic;endFill=1" edge="1" parent="1" source="step1" target="step2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#cfcfcf;endArrow=classic;endFill=1" edge="1" parent="1" source="step2" target="step3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#cfcfcf;endArrow=classic;endFill=1" edge="1" parent="1" source="step3" target="step4"><mxGeometry relative="1" as="geometry"/></mxCell>
