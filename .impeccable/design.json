  "narrative": {
    "northStar": "The Daylight Service Diagram",
    "overview": "Housing Evidence reads like a clear service route: an open white ground, a cool request rail, navy text and a cobalt line connect controls to their evidence. Humanist type and aligned numerical records make dense inspection feel calm and deliberate.\n\nThe built system is flat, precise and operational. Open station circles mark meaningful positions; connectors express real dependencies; selected records repeat the same cobalt treatment. A contained navy diagram provides contrast within the light workspace. Color supports named states, and evidence remains readable as text.",
    "keyCharacteristics": [
      "White reading ground with cool tonal panels and thin dividers.",
      "One cobalt selection grammar across controls, charts and records.",
      "Humanist Public Sans with tabular numbers and monospaced evidence.",
      "Open station geometry, explicit feedback and readable mobile alternatives."
    ],
    "rules": [
      {
        "name": "The Linked Selection Rule",
        "body": "Use cobalt and its pale ground to identify the same selected month or record across adjacent views; preserve the accompanying text and position cues.",
        "section": "colors"
      },
      {
        "name": "The Evidence Type Rule",
        "body": "Keep prose and interface labels in Public Sans, use tabular figures for compared values, and reserve monospace for hashes, code and captured payloads.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate regions with whitespace, thin dividers and tonal grounds. The current system uses no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do repeat the selected month in the chart, inspector and canonical table.",
      "Do pair semantic color with visible state words, including Synthetic and the live or replay mode.",
      "Do retain visible keyboard focus, readable mobile evidence and reduced-motion behavior.",
      "Do let open circles and connectors represent actual data positions and workflow dependencies.",
      "Do place event type, scope and mode in labeled metadata below the related heading."
    ],
    "donts": [
      "Don't plot a missing observation as a price or connect across an absent value.",
      "Don't replace the light reading ground with a page-wide dark theme; navy belongs to the workflow diagram.",
      "Don't turn unavailable or pending evidence into a positive status or a completed-looking numerical result.",
      "Don't introduce decorative transit hardware, photographic surfaces or unlabelled color-only controls."
    ]
  }
