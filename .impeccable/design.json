      "html": "<div class=\"ds-table-scroll\"><table class=\"ds-table\"><caption class=\"ds-caption\">Canonical monthly record</caption><thead><tr><th class=\"ds-table-head\" scope=\"col\">Month</th><th class=\"ds-table-head\" scope=\"col\">Observations</th></tr></thead><tbody><tr class=\"ds-selected\"><th class=\"ds-table-cell ds-identity\" scope=\"row\">September 2026</th><td class=\"ds-table-cell\">0</td></tr></tbody></table></div>",
      "css": ".ds-table-scroll{width:100%;overflow-x:auto}.ds-table{border-collapse:collapse;width:100%;color:var(--ink,#18263d);font-family:'Public Sans Variable','Public Sans',sans-serif;font-size:11.85px;font-variant-numeric:tabular-nums;line-height:1.55}.ds-caption{text-align:left;color:var(--muted,#53627a);font-size:10.95px;padding-bottom:13px}.ds-table-head,.ds-table-cell{padding:12px 11px;text-align:right;border-bottom:1px solid #e5eaf1;white-space:nowrap}.ds-table-head{font-size:10.5px;font-weight:550;color:var(--muted,#53627a);background:#f8fafc;padding-block:10px}.ds-table-head:first-child,.ds-identity{text-align:left}.ds-identity{position:sticky;left:0;font-weight:500}.ds-selected,.ds-selected .ds-identity{background:var(--accent-pale,#edf2ff)}.ds-selected .ds-identity{color:var(--accent,#234eca);font-weight:600}"
